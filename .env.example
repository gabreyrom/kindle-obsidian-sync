# Google Gemini API Key for intelligent highlight delta merging
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model (default: gemini-3.8-flash; fallbacks: gemini-3.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Minimum seconds between LLM calls (default: 12.0 for Free Tier 5 RPM safety; set to 0 if on pay-as-you-go)
GEMINI_REQUEST_INTERVAL=12.0

# Optional default path to your Obsidian vault root directory
DEFAULT_VAULT_PATH=

